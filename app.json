{
  "expo": {
    "name": "cykel-service-v0",
    "slug": "cykel-service-v0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mbcykelservice.jpg",
    "scheme": "cykel-service-v0",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mbcykelservice.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mbcykelservice.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/mbcykelservice.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a88134e7-7835-4eda-b3d3-d68c2f7b8546"
      }
    },
    "owner": "simonfrom"
  }
}
